{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lulwimi",
  "version": "0.1.0",
  "identifier": "com.wsco.lulwimi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lulwimi",
        "width": 420,
        "height": 700,
        "minWidth": 340,
        "minHeight": 230,
        "resizable": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
